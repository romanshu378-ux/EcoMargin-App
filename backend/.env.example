# ==============================================================================
# EcoMargin Backend Environment Variables Template for Production (Render)
# ==============================================================================

# Spring Profile (prod for Render production deployment)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render sets this dynamically via PORT environment variable)
PORT=8080

# PostgreSQL Database Connection (Required)
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-xxxxxxxxx-a.oregon-postgres.render.com/ecomargin_db?sslmode=require
SPRING_DATASOURCE_USERNAME=ecomargin_user
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password

# Redis Configuration (Optional - Set ENABLE_REDIS=true to activate)
ENABLE_REDIS=false
SPRING_DATA_REDIS_HOST=red-xxxxxxxxx.render.com
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your_secure_redis_password

# Security & Authentication
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
CRYPTO_KEY=404E635266556A586E3272357538782F
